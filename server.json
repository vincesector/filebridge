{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.vincesector/filebridge",
  "title": "filebridge",
  "description": "Upload any-size local files from AI agents: your signed-in browser, file inputs, drop zones, rclone.",
  "websiteUrl": "https://filebridge.evinho.xyz",
  "repository": {
    "url": "https://github.com/vincesector/filebridge",
    "source": "github"
  },
  "version": "0.2.0",
  "packages": [
    {
      "registryType": "pypi",
      "registryBaseUrl": "https://pypi.org",
      "identifier": "filebridge-mcp",
      "version": "0.2.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
